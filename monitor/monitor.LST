 106          // 定时器0中断服务函数
 107          void Timer0_ISR(void) interrupt 1 {
 108   1          static unsigned char counter = 0;
 109   1          
 110   1          TH0 = 0xFC;          // 重装初值
 111   1          TL0 = 0x73;
 112   1          
 113   1          // PWM周期为10ms（10个1ms中断）
 114   1          if(++counter >= 10) {
 115   2              counter = 0;
 116   2          }
 117   1          // PWM控制逻辑
C51 COMPILER V9.57.0.0   MONITOR                                                           01/31/2026 19:06:00 PAGE 3   

 118   1          if(pwm_enable) { 
