  94          // 根据 motor_direction 执行对应的电机动作
  95          static void Motor_Run(void) {
  96   1          switch(motor_direction) {
  97   2              case 1: Motor_Forward();  break;
  98   2              case 2: Motor_Backward(); break;
  99   2              case 3: Motor_TurnLeft(); break;
 100   2              case 4: Motor_TurnRight(); break;
 101   2              default: Motor_Stop();    break;
 102   2          }
 103   1      }
 104          
 105          // 定时器0中断服务函数
 106          void Timer0_ISR(void) interrupt 1 {
 107   1          static unsigned char counter = 0;
 108   1          
 109   1          TH0 = 0xFC;          // 重装初值
 110   1          TL0 = 0x73;
 111   1          
 112   1          // PWM周期为10ms（10个1ms中断）
 113   1          if(++counter >= 10) {
 114   2              counter = 0;
 115   2          }
 116   1          // PWM控制逻辑
 117   1          if(pwm_enable) { 
C51 COMPILER V9.57.0.0   MONITOR                                                           01/31/2026 19:20:07 PAGE 3   

 118   2              if(motor_direction == 0 || pwm == 0) {
 119   3                  // 停止或占空比为0%
 120   3                  Motor_Stop();
 121   3              } 
 122   2              else if(pwm == 10) {
 123   3                  // 占空比为100%，电机一直转
 124   3                  Motor_Run();
 125   3              }
 126   2              else {
 127   3                  // 根据占空比控制电机
 128   3                  if(counter < pwm) {
 129   4                      Motor_Run();      // 高电平期间电机转
 130   4                  } else {
 131   4                      Motor_Stop();     // 低电平期间电机停
 132   4                  }
 133   3              }
