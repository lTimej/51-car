  81          // 定时器初始化（用于产生PWM）
  82          void Timer0_Init(void) {
  83   1          TMOD &= 0xF0; 
  84   1          TMOD |= 0x01;      // 定时器0，模式1（16位定时器）
  85   1          // 设置定时器初值，产生约10KHz的PWM
  86   1          TH0 = 0xFC;  // 100us中断一次 -> 10KHz
  87   1          TL0 = 0x73;
  88   1          ET0 = 1;           // 使能定时器0中断
