{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build 8051 Project",
            "type": "shell",
            "command": "E:/keil_c51/C51/BIN/C51.EXE",
            "args": [
                "src/main.c",
                "DEBUG",
                "CODE",
                "OMF2",
                "OBJECTEXTEND",
                "BROWSE",
                "OPTIMIZE(8,SPEED)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": ["relative", "${workspaceRoot}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}

