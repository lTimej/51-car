{
  "configurations": [
    {
      "name": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "CODE",
        "DEBUG",
        "__C51__",
        "__XC51__",
        "__C51__V6__",
        "bit=unsigned char",
        "sbit=volatile bit",
        "sfr=volatile unsigned char",
        "code=const",
        "data=",
        "idata=",
        "xdata=",
        "pdata=",
        "_at_=",
        "using=//using",
        "interrupt=//interrupt"
      ],
      "compilerPath": "E:/mingw64/bin/gcc.exe",
      "cStandard": "${default}",
      "intelliSenseMode": "windows-gcc-x64",
      "cppStandard": "${default}"
    }
  ],
  "version": 4
}