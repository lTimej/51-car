  32   1      }
  33          
  34          // 发送一个字符
  35          void UART_SendChar(unsigned char ch) {
  36   1          SBUF = ch;        // 将字符放入发送缓冲区
  37   1          while(!TI);       // 等待发送完成
  38   1          TI = 0;           // 清除发送中断标志
  39   1      }
  40          
  41          // 发送字符串
  42          void UART_SendString(unsigned char *str) {
